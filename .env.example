# ==========================================
# GateMate - Environment Variables Template
# ==========================================
# Copy this file to .env or .env.local for local development.
# Ensure all production secrets are securely populated in your deployment environment.

# ------------------------------------------
# 1. Database Configuration
# ------------------------------------------
# PostgreSQL Connection URL (e.g. Supabase, Neon, AWS RDS, or local Postgres)
DATABASE_URL="postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require"

# ------------------------------------------
# 2. Application URLs
# ------------------------------------------
# Public URL of the web application (e.g., https://app.gatemate.io or http://localhost:3000)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# ------------------------------------------
# 3. Authentication (Better-Auth)
# ------------------------------------------
# Secret key used for signing session tokens (must be at least 32 characters)
BETTER_AUTH_SECRET="your-at-least-32-char-random-auth-secret-key"
# Base URL for auth callbacks and API endpoints
BETTER_AUTH_URL="https://your-domain.com"

# ------------------------------------------
# 4. Stripe Integration & Payments
# ------------------------------------------
# Stripe Secret API Key (sk_live_... for production, sk_test_... for staging/dev)
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key_here"

# Stripe Webhook Endpoint Secret (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"

# Stripe Publishable Key (pk_live_... for production, pk_test_... for staging/dev)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key_here"

# Application Fee Cut Percentage (e.g. 5.0 for 5% platform fee)
STRIPE_PLATFORM_FEE_PERCENT="5.0"

# ------------------------------------------
# 5. QR Code Ticket Verification (Cryptographic JWT)
# ------------------------------------------
# Secret key used for HMAC-SHA256 signing of ticket QR tokens (must be at least 32 characters)
QR_SIGNING_SECRET="your-32-byte-secure-random-qr-signing-secret"

# ------------------------------------------
# 6. Initial Superadmin Credentials (Production Admin Creation)
# ------------------------------------------
# Specify your initial Superadmin account credentials for production setup.
# If configured, logging in with these credentials will automatically bootstrap the Superadmin user.
ADMIN_EMAIL="admin@your-domain.com"
ADMIN_PASSWORD="YourSecureAdminPassword123!"

# ------------------------------------------
# 7. Demo & Test Accounts Guard
# ------------------------------------------
# Set to "true" ONLY in Dev/Staging environments to enable demo accounts and seeding.
# MUST be set to "false" in Production!
ENABLE_DEMO_ACCOUNTS="false"
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS="false"
